[web]
farzad-01.farzy.org ansible_user=farzad_farid ansible_python_interpreter=python3

[laptops]
# serenity's ansible_python_interpreter is pinned to the arm Homebrew python3.12
# to avoid discovering the Intel one under Rosetta. Keep `python@3.12` in
# vars/laptop.yml's laptop_setup_homebrew_packages, or bump this in lockstep.
serenity ansible_connection=local ansible_become=false ansible_python_interpreter=/opt/homebrew/bin/python3.12
FRMPTMACFH396 ansible_connection=local ansible_become=false

[k8s]
k8S.farzad.tech ansible_user=debian ansible_python_interpreter=python3

# One group per server, and one playbook per group. Groups deliberately do not
# overlap: a host in two groups could be converged by two CI jobs at once, and
# made the deploy workflow's playbook and --limit inputs able to disagree.
[quassel]
quassel.farzy.org ansible_user=debian ansible_python_interpreter=python3

[openclaw]
claw.farzad.tech ansible_user=debian ansible_python_interpreter=python3

# Base OS config and the Minecraft game servers, both from
# playbooks/minecraft.yml.
[minecraft]
minecraft-01.farzad.tech ansible_user=debian ansible_python_interpreter=python3
