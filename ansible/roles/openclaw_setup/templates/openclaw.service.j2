[Unit]
Description=OpenClaw Service
After=network.target

[Service]
Type=simple
User={{ openclaw_setup_user }}
Group={{ openclaw_setup_group }}
WorkingDirectory={{ openclaw_setup_home }}
EnvironmentFile=/etc/openclaw/secrets.env

ExecStart=/usr/bin/env openclaw gateway --port {{ openclaw_setup_port }}
Restart=always
RestartSec=10

# Sandboxing & Security Hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ openclaw_setup_home }} /var/tmp/openclaw-compile-cache
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
