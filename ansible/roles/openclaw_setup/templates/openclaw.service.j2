[Unit]
Description=OpenClaw Service
After=network.target

[Service]
Type=simple
User={{ openclaw_setup_user }}
Group={{ openclaw_setup_group }}
WorkingDirectory={{ openclaw_setup_home }}
EnvironmentFile=/etc/openclaw/secrets.env

ExecStart=/usr/bin/env openclaw gateway --port {{ openclaw_setup_port }}
Restart=always
RestartSec=10

# --- SECURITY HARDENING & SANDBOXING ---

# Mount system directories (/usr, /etc, /boot) as read-only to prevent OS file modification
ProtectSystem=strict

# Allow write access exclusively to OpenClaw's home directory and Node compilation cache
ReadWritePaths={{ openclaw_setup_home }} /var/tmp/openclaw-compile-cache

# Disable ProtectHome restriction so user claw can manage its database, configuration, and workspace files in /home/claw
ProtectHome=false

# Mount a private, isolated /tmp and /var/tmp namespace to prevent multi-tenant token leakage
PrivateTmp=true

# Set MemoryDenyWriteExecute to false because Node.js V8 engine requires W^X JIT compilation memory allocation
MemoryDenyWriteExecute=false

# Set NoNewPrivileges to false so the service user can invoke sudo or administrative commands if configured
NoNewPrivileges=false

# Protect kernel variables (/proc/sys, /sys, /proc/sysrq-trigger) from modification
ProtectKernelTunables=true

# Prevent loading or unloading Linux kernel modules at runtime
ProtectKernelModules=true

# Mount control group hierarchies (/sys/fs/cgroup) as read-only
ProtectControlGroups=true

# Prevent the service from acquiring realtime scheduling priorities to avoid CPU starvation attacks
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
