#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Runs an `openclaw` CLI subcommand as the `{{ openclaw_setup_user }}` service
# user with the same environment the systemd-managed gateway gets from
# /etc/openclaw/secrets.env (GEMINI_API_KEY, CLAUDE_CODE_OAUTH_TOKEN,
# SCALEWAY_API_KEY, ANSIBLE_VAULT_PASSWORD, NODE_COMPILE_CACHE,
# OPENCLAW_NO_RESPAWN, ...).
#
# One-off admin subcommands like `openclaw doctor --fix` spawn a fresh CLI
# process rather than talking to the already-running gateway, so a plain
# `sudo -u {{ openclaw_setup_user }} openclaw ...` sees none of that
# environment and misreports normal config as broken (missing API keys,
# NODE_COMPILE_CACHE, OPENCLAW_NO_RESPAWN, ...).
#
# Uses `systemd-run --property=EnvironmentFile=...` rather than bash
# `source`-ing the file directly: systemd's own EnvironmentFile= parser does
# no shell expansion or command substitution on the values, but a bash
# `source` does — a secret containing `$`, a backtick, or `$(...)` would
# either resolve differently here than it does for the real service, or get
# executed as root by this wrapper. Routing through systemd-run gives this
# wrapper the exact same parse the systemd-managed gateway gets, and lets
# systemd (not this script) do the privileged read of the root-only secrets
# file, so no `sudo -u ... -E -H` dance is needed either.
#
# Sets OPENCLAW_SERVICE_REPAIR_POLICY=external: our openclaw.service is a
# plain system-level unit deployed by Ansible, not openclaw's own built-in
# service installer, which expects to verify shutdown through a
# `systemctl --user` unit + D-Bus user session bus for
# `{{ openclaw_setup_user }}` — neither of which exists here (no lingering
# systemd user session). Without this, `doctor --fix` refuses with "Gateway
# service ownership or shutdown could not be verified" even after a correct
# `systemctl stop openclaw`. The "external" policy skips that native
# service-manager inspection/mutation (state and agent-database lease checks
# still run) and leaves stop/start responsibility with us — see
# docs/openclaw.md §8 for the stop/fix/start sequence this still requires.
#
# Deliberately does NOT set OPENCLAW_CONFIG_READONLY — that flag lives only
# on the systemd unit's own Environment= line (openclaw.service.j2), not
# here, specifically so manual commands run through this wrapper are never
# accidentally blocked by it.
#
# Usage: sudo openclaw-admin <openclaw-subcommand-and-args...>
#   sudo systemctl stop openclaw && sudo openclaw-admin doctor --fix && sudo systemctl start openclaw
#   sudo openclaw-admin status --deep

set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  echo "openclaw-admin must be run as root (sudo openclaw-admin ...) — it reads root-only /etc/openclaw/secrets.env" >&2
  exit 1
fi

exec systemd-run --quiet --pipe --wait --same-dir \
  --uid={{ openclaw_setup_user }} \
  --property=EnvironmentFile=/etc/openclaw/secrets.env \
  --setenv=HOME={{ openclaw_setup_home }} \
  --setenv=OPENCLAW_SERVICE_REPAIR_POLICY=external \
  openclaw "$@"
