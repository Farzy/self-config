#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Runs an `openclaw` CLI subcommand as the `{{ openclaw_setup_user }}` service
# user with the same environment the gateway gets from /etc/openclaw/secrets.env
# (OPENCLAW_GATEWAY_TOKEN, TELEGRAM_BOT_TOKEN, GEMINI_API_KEY,
# CLAUDE_CODE_OAUTH_TOKEN, SCALEWAY_API_KEY, NODE_COMPILE_CACHE,
# OPENCLAW_NO_RESPAWN, ...).
#
# This is the supported way to run admin commands from the `debian` account.
# A plain `sudo -u {{ openclaw_setup_user }} openclaw ...` fails twice over:
# sudo's secure_path does not include the claw-owned npm prefix OpenClaw now
# lives in, and even with a full path the process would see none of the service
# environment. That breaks `doctor --fix` (misreports normal config as broken)
# and anything that talks to the gateway, whose token openclaw.json only
# references as an env SecretRef (see docs/openclaw.md §4.1).
#
# Runs the command as a transient unit in {{ openclaw_setup_user }}'s own systemd
# user manager (`systemd-run --user --machine=...@`) rather than through sudo:
#   * systemd's EnvironmentFile= parser does no shell expansion or command
#     substitution, so a secret containing `$`, a backtick, or `$(...)` is read
#     exactly as the gateway reads it — and nothing is ever `source`d as root.
#   * the command gets the user's runtime dir and user bus, which OpenClaw needs
#     to inspect or drive its `{{ openclaw_setup_systemd_unit }}` user unit.
#   * the command runs from an absolute path in the claw-owned prefix and never
#     as root: that tree is writable by {{ openclaw_setup_user }}, so executing it
#     with root privileges would hand the agent a privilege escalation.
#
# Sets OPENCLAW_SERVICE_REPAIR_POLICY=external: the gateway unit is authored by
# Ansible (root-owned, "sealed" from OpenClaw's point of view), so manual Doctor
# runs stay diagnostic-only for the service lifecycle — no reinstalling or
# rewriting the unit, and stop/start stays with us. State and database checks
# still run. See docs/openclaw.md §8 for the stop/fix/start sequence.
#
# Deliberately does NOT set OPENCLAW_CONFIG_READONLY, and never inherits it:
# that flag, when enabled, lives only on the unit's own Environment= line.
#
# Usage: sudo openclaw-admin <openclaw-subcommand-and-args...>
#   sudo openclaw-admin status --deep
#   sudo openclaw-admin pairing approve <CODE>
#   sudo systemctl --user -M {{ openclaw_setup_user }}@ stop {{ openclaw_setup_systemd_unit }} \
#     && sudo openclaw-admin doctor --fix \
#     && sudo systemctl --user -M {{ openclaw_setup_user }}@ start {{ openclaw_setup_systemd_unit }}

set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  echo "openclaw-admin must be run as root (sudo openclaw-admin ...) — it starts a unit in the {{ openclaw_setup_user }} user manager" >&2
  exit 1
fi

exec systemd-run --user --machine={{ openclaw_setup_user }}@ \
  --quiet --pipe --wait --collect \
  --working-directory={{ openclaw_setup_home }} \
  --property=EnvironmentFile=/etc/openclaw/secrets.env \
  --setenv=PATH={{ openclaw_setup_npm_prefix }}/bin:/usr/local/bin:/usr/bin:/bin \
  --setenv=OPENCLAW_SERVICE_REPAIR_POLICY=external \
  {{ openclaw_setup_npm_prefix }}/bin/openclaw "$@"
