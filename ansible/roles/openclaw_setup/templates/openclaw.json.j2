{
  "gateway": {
    "mode": "local",
    "port": {{ openclaw_setup_port }},
    "auth": {
      "mode": "token",
      "token": "{{ openclaw_gateway_token }}"
    }

  },
  "agents": {


    "defaults": {
      "model": {
        "primary": "{{ openclaw_setup_model }}"
      }
    }
  },
  "plugins": {
    "entries": {
      "signal": {
        "enabled": true
      }
    }
  },
  "channels": {
    "signal": {
      "enabled": true,
      "cliPath": "/usr/local/bin/signal-cli",
      "dmPolicy": "pairing",
      "allowFrom": {{ openclaw_setup_signal_allow_from | to_json }}
    }
  }
}

