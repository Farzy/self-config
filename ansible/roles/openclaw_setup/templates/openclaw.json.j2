{
  "gateway": {
    "mode": "local",
    "port": {{ openclaw_setup_port }},
    "trustedProxies": [
      "127.0.0.1",
      "::1"
    ],
    "controlUi": {
      "allowedOrigins": {{ openclaw_setup_allowed_origins | to_json }}
    },
    "auth": {
      "mode": "token",
      "token": "{{ openclaw_gateway_token }}"
    }
  },
  "commands": {
    "native": {
      "mcp": true
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "{{ openclaw_setup_model }}"
      }
    }
  },
  "plugins": {
    "entries": {
      "signal": {
        "enabled": true
      }{% if openclaw_setup_telegram_enabled and openclaw_telegram_bot_token is defined %},
      "telegram": {
        "enabled": true
      }
{%- endif %}
    }
  },
  "channels": {
    "signal": {
      "enabled": true,
      "cliPath": "/usr/local/bin/signal-cli",
      "dmPolicy": "pairing",
      "allowFrom": {{ openclaw_setup_signal_allow_from | to_json }}
    }{% if openclaw_setup_telegram_enabled and openclaw_telegram_bot_token is defined %},
    "telegram": {
      "enabled": true,
      "botToken": "{{ openclaw_telegram_bot_token }}",
      "dmPolicy": "pairing",
      "allowFrom": {{ openclaw_setup_telegram_allow_from | to_json }}
    }
{%- endif %}
  }
{% if openclaw_fastmail_token is defined %},
  "mcp": {
    "servers": {
      "fastmail": {
        "url": "https://api.fastmail.com/mcp",
        "transport": "sse",
        "headers": {
          "Authorization": "Bearer {{ openclaw_fastmail_token }}"
        }
      }
    }
  }
{%- endif %}
}