{#- Credentials are env SecretRefs resolved from /etc/openclaw/secrets.env, never
    plaintext here: this file lives in the agent-readable state dir, and OpenClaw's
    updater and Doctor copy it into .bak and rollback snapshots. Verify with
    `sudo openclaw-admin secrets audit --check`. See docs/openclaw.md §4.1. #}
{
  "update": {
    "channel": "{{ openclaw_setup_update_channel }}",
    "auto": {
      "enabled": false
    }
  },
  "gateway": {
    "mode": "local",
    "port": {{ openclaw_setup_port }},
    "trustedProxies": [
      "127.0.0.1",
      "::1"
    ],
    "controlUi": {
      "allowedOrigins": {{ openclaw_setup_allowed_origins | to_json }}
    },
    "auth": {
      "mode": "token",
      "token": {"source": "env", "provider": "default", "id": "OPENCLAW_GATEWAY_TOKEN"}
    }
  },
  "commands": {
    "ownerAllowFrom": {{ openclaw_setup_telegram_allow_from | to_json }}
  },
{% set ns = namespace(models={}, allow_models=[]) %}
{% if openclaw_setup_claude_cli_enabled %}
{% set ns.models = ns.models | combine({openclaw_setup_model: {"agentRuntime": {"id": "claude-cli"}}}) %}
{% endif %}
{% if openclaw_setup_scaleway_enabled | default(false) %}
{% for scaleway_model_id in openclaw_setup_scaleway_reasoning_model_ids %}
{% set ns.models = ns.models | combine({"scaleway/" ~ scaleway_model_id: {"params": {"extra_body": {"thinking": {"type": "enabled"}, "reasoning_effort": "high"}}}}) %}
{% endfor %}
{% endif %}
{# agents.defaults.modelPolicy.allow: primary + fallbacks, plus every model any
   configured provider actually exposes (so a manually-selected, non-fallback
   model like Mistral Small isn't silently blocked) — deduped since the
   primary can legitimately also appear in the fallback list (e.g. the
   documented "Reverting to Gemini as primary" path). #}
{% set ns.allow_models = ([openclaw_setup_model] + (openclaw_setup_model_fallbacks | default([])) + (openclaw_setup_scaleway_models | map(attribute='id') | map('regex_replace', '^', 'scaleway/') | list if openclaw_setup_scaleway_enabled | default(false) else [])) | unique | list %}
  "agents": {
    "defaults": {
      "model": {
        "primary": "{{ openclaw_setup_model }}"{% if openclaw_setup_model_fallbacks | default([]) | length > 0 %},
        "fallbacks": {{ openclaw_setup_model_fallbacks | to_json }}
{% endif %}
      },
      "models": {{ ns.models | to_json }},
      "reasoningDefault": "{{ openclaw_setup_reasoning_default }}",
      "modelPolicy": {
        "allow": {{ ns.allow_models | to_json }}
      }
    },
    "entries": {
      "main": {
        "identity": {
          "avatar": "{{ openclaw_setup_avatar }}"
        }
      }
    }
  },
  "memory": {
    "search": {
      "provider": "{{ openclaw_setup_memory_search_provider }}",
      "model": "{{ openclaw_setup_memory_search_model }}"{% if openclaw_setup_memory_search_extra_paths is defined and openclaw_setup_memory_search_extra_paths | length > 0 %},
      "extraPaths": {{ openclaw_setup_memory_search_extra_paths | to_json }}
{% endif %}
    }
  },
  "plugins": {
    "entries": {
      "signal": {
        "enabled": true
      },
      "google": {
        "enabled": true
      },
      "memory-wiki": {
        "enabled": {{ openclaw_setup_memory_wiki_enabled | to_json }}
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": {{ openclaw_setup_dreaming_enabled | to_json }}
          }
        },
        "enabled": true
      }{% if openclaw_setup_telegram_enabled and openclaw_telegram_bot_token is defined %},
      "telegram": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      }
{% endif %}
    }
  },
  "channels": {
    "signal": {
      "enabled": true,
      "dmPolicy": "pairing",
      "allowFrom": {{ openclaw_setup_signal_allow_from | to_json }},
      "account": "{{ openclaw_setup_signal_account }}",
      "transport": {
        "kind": "managed-native",
        "cliPath": "{{ openclaw_setup_signal_cli_path }}"
      }
    }{% if openclaw_setup_telegram_enabled and openclaw_telegram_bot_token is defined %},
    "telegram": {
      "enabled": true,
      "botToken": {"source": "env", "provider": "default", "id": "TELEGRAM_BOT_TOKEN"},
      "dmPolicy": "pairing",
      "allowFrom": {{ openclaw_setup_telegram_allow_from | to_json }},
      "threadBindings": {
        "enabled": {{ openclaw_setup_telegram_thread_bindings_enabled | to_json }}
      },
      "groupAllowFrom": {{ openclaw_setup_telegram_allow_from | to_json }}
    }
{% endif %}
  },
{% if openclaw_setup_scaleway_enabled | default(false) %}
  "models": {
    "providers": {
      "scaleway": {
        "api": "{{ openclaw_setup_scaleway_api }}",
        "baseUrl": "https://api.scaleway.ai/{{ openclaw_scaleway_project_id | default(openclaw_setup_scaleway_project_id) }}/v1",
        "apiKey": {"source": "env", "provider": "default", "id": "SCALEWAY_API_KEY"},
        "models": {{ openclaw_setup_scaleway_models | to_json }}
      }
    }
  },
{% endif %}
{% if openclaw_fastmail_token is defined %}
  "mcp": {
    "servers": {
      "fastmail": {
        "url": "http://127.0.0.1:18790/sse",
        "transport": "sse"
      }
    }
  },
{% endif %}
  "skills": {
    "load": {
      "extraDirs": ["{{ openclaw_setup_home }}/src/agent-skills/skills"],
      "allowSymlinkTargets": ["{{ openclaw_setup_home }}/src/agent-skills/skills"]
    },
    "entries": {
      "1password": {
        "enabled": false
      },
      "blogwatcher": {
        "enabled": false
      },
      "blucli": {
        "enabled": false
      },
      "camsnap": {
        "enabled": false
      },
      "coding-agent": {
        "enabled": false
      },
      "eightctl": {
        "enabled": false
      },
      "gemini": {
        "enabled": false
      },
      "gifgrep": {
        "enabled": false
      },
      "gog": {
        "enabled": {{ (openclaw_gog_refresh_token_export_json is defined) | to_json }}
      },
      "goplaces": {
        "enabled": false
      },
      "himalaya": {
        "enabled": false
      },
      "mcporter": {
        "enabled": false
      },
      "nano-pdf": {
        "enabled": false
      },
      "obsidian": {
        "enabled": false
      },
      "openai-whisper": {
        "enabled": false
      },
      "openai-whisper-api": {
        "enabled": false
      },
      "openhue": {
        "enabled": false
      },
      "oracle": {
        "enabled": false
      },
      "ordercli": {
        "enabled": false
      },
      "sag": {
        "enabled": false
      },
      "sherpa-onnx-tts": {
        "enabled": false
      },
      "songsee": {
        "enabled": false
      },
      "sonoscli": {
        "enabled": false
      },
      "spotify-player": {
        "enabled": false
      },
      "summarize": {
        "enabled": false
      },
      "trello": {
        "enabled": false
      },
      "video-frames": {
        "enabled": false
      },
      "xurl": {
        "enabled": false
      },
      "model-usage": {
        "enabled": false
      }
    }
  }{% if openclaw_setup_claude_cli_enabled %},
  "auth": {
    "profiles": {
      "anthropic:manual": {
        "provider": "anthropic",
        "mode": "token"
      }
    }
  }
{% endif %}
}
