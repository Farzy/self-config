# {{ ansible_managed }}
PORT={{ openclaw_setup_port }}
NODE_COMPILE_CACHE={{ openclaw_setup_compile_cache }}
OPENCLAW_NO_RESPAWN=1
GEMINI_API_KEY={{ openclaw_gemini_api_key }}
{% if openclaw_claude_code_oauth_token is defined and openclaw_claude_code_oauth_token | length > 0 %}
CLAUDE_CODE_OAUTH_TOKEN={{ openclaw_claude_code_oauth_token }}
# OpenClaw strips CLAUDE_CODE_OAUTH_TOKEN (and other Anthropic auth env vars) before
# spawning the `claude` CLI subprocess by default (extensions/anthropic/cli-shared.ts
# CLAUDE_CLI_CLEAR_ENV) so ambient env auth can't silently override its managed auth
# profile. This headless host has no interactive `claude auth login` session to reuse
# instead, so the token must be explicitly whitelisted through, or every claude-cli
# turn fails with "Not logged in" and silently falls back to the next model.
OPENCLAW_LIVE_CLI_BACKEND_PRESERVE_ENV=CLAUDE_CODE_OAUTH_TOKEN
{% endif %}
{% if openclaw_github_pat is defined and openclaw_github_pat | length > 0 %}
GITHUB_TOKEN={{ openclaw_github_pat }}
GH_TOKEN={{ openclaw_github_pat }}
{% endif %}
ANSIBLE_VAULT_PASSWORD="{{ lookup('file', '~/.ansible-personal-key') | trim }}"
{% if openclaw_notion_api_token is defined %}
NOTION_API_TOKEN={{ openclaw_notion_api_token }}
NOTION_API_VERSION=2026-03-11
{% endif %}
{% if openclaw_scaleway_api_key is defined and openclaw_scaleway_api_key | length > 0 %}
SCALEWAY_API_KEY={{ openclaw_scaleway_api_key }}
{% elif openclaw_setup_scaleway_api_key is defined and openclaw_setup_scaleway_api_key | length > 0 %}
SCALEWAY_API_KEY={{ openclaw_setup_scaleway_api_key }}
{% endif %}
